generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model usuario {
  id                  BigInt               @id @default(autoincrement())
  created_at          DateTime             @default(now()) @db.Timestamptz(6)
  nome                String?              @db.VarChar
  email               String?              @db.VarChar
  passwordHash        String?              @db.VarChar
  xp                  Int?
  level               Int?                 @db.SmallInt
  ofensivaAtual       Int?                 @db.SmallInt
  recordeMaximo       Int?                 @db.SmallInt
  dataUltimaAtividade DateTime?            @db.Timestamptz(6)
  avatarUrl           String?              @db.VarChar
  usuario_atividades  usuario_atividades[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model atividade_frequente {
  id_atividade_frequente Int       @id @default(autoincrement())
  id_usuario             Int
  nome_atividade         String    @db.VarChar(100)
  categoria              String    @db.VarChar(50)
  repete_seg             Boolean?  @default(false)
  repete_ter             Boolean?  @default(false)
  repete_qua             Boolean?  @default(false)
  repete_qui             Boolean?  @default(false)
  repete_sex             Boolean?  @default(false)
  repete_sab             Boolean?  @default(false)
  repete_dom             Boolean?  @default(false)
  horario                DateTime  @db.Time(6)
  criado_em              DateTime? @default(now()) @db.Timestamp(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model atividades {
  id_atividade        BigInt               @id @default(autoincrement())
  nome_atividade      String               @db.VarChar
  categoria_atividade Int?                 @db.SmallInt
  xp_atividade        Int?                 @db.SmallInt
  repeticao_atividade Int?                 @db.SmallInt
  usuario_atividades  usuario_atividades[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model conquistas {
  id_conquista        BigInt @id @default(autoincrement())
  nome_conquista      String @db.VarChar
  nivel_conquista     Int?   @db.SmallInt
  categoria_conquista Int?   @db.SmallInt
  xp_conquista        Int?   @db.SmallInt
  nivel               Int?   @db.SmallInt
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model usuario_atividades {
  id_historico      Int         @id @default(autoincrement())
  id_usuario        BigInt      // Alterado de Int para BigInt para coincidir com model usuario (id)
  id_atividade      BigInt      // Alterado de Int para BigInt para coincidir com model atividades (id_atividade)
  xp_ganho          Int
  data_realizacao   DateTime?   @default(now()) @db.Timestamp(6)
  observacao        String?     @db.VarChar(255)
  duracao_minutos   Int         @default(0)
  intensidade       String      @default("Moderado") @db.VarChar(20)
  atividades        atividades  @relation(fields: [id_atividade], references: [id_atividade], onDelete: NoAction, onUpdate: NoAction)
  usuario           usuario     @relation(fields: [id_usuario], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model usuario_conquistas {
  id_usuario_conquista Int       @id @default(autoincrement())
  id_usuario           Int
  id_conquista         Int
  data_desbloqueio     DateTime? @default(now()) @db.Timestamp(6)
  progresso_atual      Int?      @default(0)
}
